PORT=3000
NODE_ENV=development

JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Prisma connection string (SQLite). Either set DATABASE_URL directly,
# or set DATABASE_PATH and it will be converted to file:<path>.
DATABASE_URL=file:./data.db
DATABASE_PATH=./data.db

UPLOAD_DIR=./storage/videos
MAX_FILE_SIZE=104857600  # 100MB in bytes

CORS_ORIGIN=http://localhost:3000

# Signed stream URLs. If STREAM_TOKEN_SECRET is unset, a key is derived from
# JWT_ACCESS_SECRET. Set it explicitly in production.
# STREAM_TOKEN_SECRET=your-stream-secret-change-in-production
STREAM_TOKEN_EXPIRES_IN=2h
